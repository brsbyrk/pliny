# Pliny configuration
# Copy to .env and fill in your values

# DeepSeek API key (required for synthesis, Q&A, auto-tagging)
DEEPSEEK_API_KEY=

# Optional: LLM configuration overrides
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# Optional: Pliny server config
# PLINY_HOST=0.0.0.0
# PLINY_PORT=3131
